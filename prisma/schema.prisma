generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct/session connection for migrations (Supabase port 5432).
  // Transaction pooler (port 6543 + pgbouncer) goes in DATABASE_URL for Vercel.
  directUrl = env("DIRECT_URL")
}

model Lot {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  category         String
  condition        String
  lotType          String
  saleType         String
  currentBid       Float
  buyNowPrice      Float?
  startingBid      Float
  reserveMet       Boolean   @default(false)
  bidCount         Int       @default(0)
  unitCount        Int
  quantitySold     Int       @default(0)
  minQuantity      Int       @default(1)
  sellByUnit       Boolean   @default(false)
  compareAtPrice   Float?
  estimatedRetail  Float
  location         String
  endsAt           DateTime
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  status           String    @default("open")
  soldAt           DateTime?
  winnerUserId     String?
  winnerEmail      String?
  imagesJson       String
  manifestSummary  String
  conditionNotes   String
  sellerNotes      String
  shipping         String
  pickup           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bids             Bid[]
  orders           Order[]
  reviews          Review[]
}

model Review {
  id         String   @id @default(cuid())
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  body       String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([lotId, createdAt])
}

model Bid {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  userId    String
  userEmail String
  amount    Float
  createdAt DateTime @default(now())

  @@index([lotId, createdAt])
  @@index([userId])
}

model Order {
  id                    String    @id @default(cuid())
  lotId                 String
  lot                   Lot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  userId                String
  userEmail             String
  amount                Float
  quantity              Int       @default(1)
  currency              String    @default("usd")
  status                String    @default("pending")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  termsAcceptedAt       DateTime?
  buyerFullName         String?
  buyerPhone            String?
  buyerAge              Int?
  shipStreet            String?
  shipCity              String?
  shipState             String?
  shipPostal            String?
  shipCountry           String?   @default("US")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([lotId])
  @@index([status])
}

model SellInquiry {
  id              String    @id @default(cuid())
  company         String
  contactName     String
  email           String
  phone           String?
  inventoryType   String
  categories      String?
  cities          String?
  volume          String
  userId          String?
  handled         Boolean   @default(false)
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id                 String   @id @default("default")
  contactEmail       String?
  contactPhone       String?
  whatsapp           String?
  addressNote        String?
  facebookUrl        String?
  instagramUrl       String?
  tiktokUrl          String?
  linkedinUrl        String?
  xUrl               String?
  minOrderTotalCents Int      @default(15000)
  updatedAt          DateTime @updatedAt
}
