# --- Supabase Postgres (Prisma) ---
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Supabase Auth / Storage ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server only (Storage admin uploads, trusted ops). Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Stripe (buy now / checkout) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (optional; logs if unset) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Astock <noreply@astock.market>"
NEXT_PUBLIC_SITE_URL="https://astock-one.vercel.app"

# --- Admin cookie session (separate from Supabase Auth) ---
ADMIN_EMAIL="admin@astock.market"
ADMIN_PASSWORD="change-me-strong-password"
SESSION_SECRET="long-random-session-secret"
COOKIE_SECURE="true"
